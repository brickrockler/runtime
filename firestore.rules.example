rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    match /runtime_v2_vaults/jack_sticky_notes_v3 {
      allow get: if true;
      allow create, update: if request.resource.data.keys().size() <= 8;
      allow list, delete: if false;
    }

    match /runtime_v2_vaults/{vaultId} {
      allow get: if vaultId != 'jack_sticky_notes_v3' && vaultId.size() <= 64;
      allow create: if vaultId != 'jack_sticky_notes_v3'
        && vaultId.size() <= 64
        && request.resource.data.keys().size() <= 24
        && (!('stepsTotal' in request.resource.data) || (request.resource.data.stepsTotal is int && request.resource.data.stepsTotal >= 0 && request.resource.data.stepsTotal <= 10000000))
        && (!('tokensPerStep' in request.resource.data) || (request.resource.data.tokensPerStep is int && request.resource.data.tokensPerStep >= 1 && request.resource.data.tokensPerStep <= 10000));
      allow update: if vaultId != 'jack_sticky_notes_v3'
        && vaultId.size() <= 64
        && request.resource.data.keys().size() <= 24
        && (!('fieldTokenHash' in resource.data) || resource.data.fieldTokenHash == '' || ('fieldTokenHash' in request.resource.data && request.resource.data.fieldTokenHash == resource.data.fieldTokenHash))
        && (!('stepsTotal' in request.resource.data) || (request.resource.data.stepsTotal is int && request.resource.data.stepsTotal >= 0 && request.resource.data.stepsTotal <= 10000000))
        && (!('tokensPerStep' in request.resource.data) || (request.resource.data.tokensPerStep is int && request.resource.data.tokensPerStep >= 1 && request.resource.data.tokensPerStep <= 10000));
      allow list, delete: if false;
    }
  }
}
