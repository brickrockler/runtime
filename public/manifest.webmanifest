{
  "name": "RUNTIME — Burn Calories Before You Burn Tokens",
  "short_name": "RUNTIME",
  "description": "Walk to unlock AI coding turns or OpenRouter API credit. When your step balance hits zero, your agent locks cold.",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#ff0400",
  "theme_color": "#000000",
  "icons": [
    {
      "src": "/favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    }
  ],
  "share_target": {
    "action": "/share-checkin",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "screenshot",
          "accept": [
            "image/*"
          ]
        }
      ]
    }
  }
}
